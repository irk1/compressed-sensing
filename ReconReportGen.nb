Notebook[{

Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"1.", " ", "Load", " ", "images"}], "-", 
    RowBox[{"keeping", " ", "your", " ", "working", " ", "pick"}], "-", 
    "method"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"img1", "=", 
     RowBox[{"Import", "[", 
      RowBox[{"SystemDialogInput", "[", "\"\<FileOpen\>\"", "]"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"img2", "=", 
     RowBox[{"Import", "[", 
      RowBox[{"SystemDialogInput", "[", "\"\<FileOpen\>\"", "]"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"2.", " ", "PRE"}], "-", "PROCESSING", "-", 
     RowBox[{"Brute", " ", "Force", " ", "Standardization"}]}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{"Force", " ", "Resize", " ", "first"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"img2Resized", "=", 
     RowBox[{"ImageResize", "[", 
      RowBox[{"img2", ",", 
       RowBox[{"ImageDimensions", "[", "img1", "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Force", " ", "both", " ", "to", " ", "3"}], "-", 
     RowBox[{"channel", " ", "RGB", " ", 
      RowBox[{"and", "'"}], 
      RowBox[{"Real", "'"}], " ", "bit", " ", "depth", " ", "to", " ", 
      "prevent", " ", "symbolic", " ", "mismatch"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ref", "=", 
     RowBox[{"Image", "[", 
      RowBox[{
       RowBox[{"ColorConvert", "[", 
        RowBox[{"img1", ",", "\"\<RGB\>\""}], "]"}], ",", "\"\<Real\>\""}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"recon", "=", 
     RowBox[{"Image", "[", 
      RowBox[{
       RowBox[{"ColorConvert", "[", 
        RowBox[{"img2Resized", ",", "\"\<RGB\>\""}], "]"}], ",", 
       "\"\<Real\>\""}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "3.", " ", "GENERATE", " ", "COLORFUL", " ", "HEATMAP", " ", "WITH", " ", 
     "SOLID", " ", "BORDER"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"diffImg", "=", 
     RowBox[{"ColorConvert", "[", 
      RowBox[{
       RowBox[{"ImageDifference", "[", 
        RowBox[{"ref", ",", "recon"}], "]"}], ",", "\"\<GrayScale\>\""}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rawHeatMap", "=", 
     RowBox[{"Colorize", "[", 
      RowBox[{
       RowBox[{"Image", "[", 
        RowBox[{"Rescale", "[", 
         RowBox[{"ImageData", "[", "diffImg", "]"}], "]"}], "]"}], ",", 
       RowBox[{"ColorFunction", "->", "\"\<TemperatureMap\>\""}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"heatMap", "=", 
     RowBox[{"ImagePad", "[", 
      RowBox[{"rawHeatMap", ",", "2", ",", "Black"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"4.", " ", "STATISTICAL", " ", "ANALYSIS"}], "-", "Multi", "-", 
     RowBox[{"Layered", " ", "Force", " ", "Evaluation"}]}], "*)"}], "\n", 
   RowBox[{"(*", "MSE", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"mseVal", "=", 
     RowBox[{"N", "[", 
      RowBox[{"ImageDistance", "[", 
       RowBox[{"ref", ",", "recon", ",", 
        RowBox[{
        "DistanceFunction", "->", "\"\<MeanSquaredEuclideanDistance\>\""}]}], 
       "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"PSNR", "-", 
     RowBox[{
     "Handle", " ", "potential", " ", "Log", " ", "of", " ", "Zero", " ", 
      "errors"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"psnrVal", "=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"mseVal", ">", "0"}], ",", 
       RowBox[{"10", "*", 
        RowBox[{"Log10", "[", 
         RowBox[{"1", "/", "mseVal"}], "]"}]}], ",", "100"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", "Correlation", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"corrVal", "=", 
     RowBox[{"N", "[", 
      RowBox[{"ImageDistance", "[", 
       RowBox[{"ref", ",", "recon", ",", 
        RowBox[{"DistanceFunction", "->", "\"\<CorrelationDistance\>\""}]}], 
       "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"SSIM", "-", 
     RowBox[{
      RowBox[{"The", "'"}], "Brute", " ", 
      RowBox[{"Force", "'"}], " ", "Similarity", " ", "Calculation"}]}], 
    "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "We", " ", "use", " ", "a", " ", "Check", " ", "wrapper", " ", "to", " ",
       "stop", " ", "it", " ", "from", " ", "outputting", " ", "a", " ", 
      "code"}], "-", 
     RowBox[{"box", " ", "if", " ", "it", " ", "fails"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ssimVal", "=", 
     RowBox[{"Check", "[", 
      RowBox[{
       RowBox[{"N", "[", 
        RowBox[{"ImageSimilarity", "[", 
         RowBox[{"ref", ",", "recon", ",", 
          RowBox[{"Method", "->", "\"\<StructuralSimilarity\>\""}]}], "]"}], 
        "]"}], ",", "\"\<Calculation Error\>\""}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Final", " ", 
     RowBox[{"Formatting", ":", 
      RowBox[{"Convert", " ", "everything", " ", "to", " ", "pure", " ", 
       RowBox[{"strings", "/", "numbers"}], " ", "to", " ", "kill", " ", 
       "code", " ", "boxes"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"finalMSE", "=", 
     RowBox[{"NumberForm", "[", 
      RowBox[{"mseVal", ",", 
       RowBox[{"{", 
        RowBox[{"Infinity", ",", "6"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"finalPSNR", "=", 
     RowBox[{
      RowBox[{"ToString", "[", 
       RowBox[{"Round", "[", 
        RowBox[{
         RowBox[{"N", "[", "psnrVal", "]"}], ",", "0.01"}], "]"}], "]"}], 
      "<>", "\"\< dB\>\""}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"finalCorr", "=", 
     RowBox[{"NumberForm", "[", 
      RowBox[{
       RowBox[{"N", "[", "corrVal", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"Infinity", ",", "4"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"finalSSIM", "=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"NumberQ", "[", "ssimVal", "]"}], ",", 
       RowBox[{"Round", "[", 
        RowBox[{"ssimVal", ",", "0.0001"}], "]"}], ",", 
       "\"\<Error: Re-run\>\""}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"5.", " ", "GENERATE", " ", "REPORT", " ", "LAYOUT"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"report", "=", 
     RowBox[{"Column", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{
          "\"\<Image Comparison & Reconstruction Report\>\"", ",", 
           "\"\<Title\>\"", ",", 
           RowBox[{"Darker", "[", "Blue", "]"}]}], "]"}], ",", 
         RowBox[{"TextCell", "[", 
          RowBox[{"\"\<Report Generated: \>\"", "<>", 
           RowBox[{"DateString", "[", "]"}]}], "]"}], ",", 
         RowBox[{"Item", "[", 
          RowBox[{
           RowBox[{"Grid", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                "\"\<Original Reference\>\"", ",", 
                 "\"\<Reconstructed Image\>\"", ",", 
                 "\"\<Error Heatmap\>\""}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"ImageResize", "[", 
                  RowBox[{"img1", ",", "800"}], "]"}], ",", 
                 RowBox[{"ImageResize", "[", 
                  RowBox[{"img2Resized", ",", "800"}], "]"}], ",", 
                 RowBox[{"ImageResize", "[", 
                  RowBox[{"heatMap", ",", "800"}], "]"}]}], "}"}]}], "}"}], 
             ",", 
             RowBox[{"Frame", "->", "All"}], ",", 
             RowBox[{"FrameStyle", "->", 
              RowBox[{"GrayLevel", "[", "0.8", "]"}]}]}], "]"}], ",", 
           RowBox[{"Alignment", "->", "Center"}]}], "]"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{"\"\<Statistical Metrics\>\"", ",", "\"\<Subtitle\>\""}], 
          "]"}], ",", 
         RowBox[{"Grid", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"\"\<Metric\>\"", ",", "\"\<Value\>\""}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"\"\<Mean Squared Error (MSE)\>\"", ",", "finalMSE"}], 
              "}"}], ",", 
             RowBox[{"{", 
              RowBox[{
              "\"\<Peak Signal-to-Noise Ratio (PSNR)\>\"", ",", "finalPSNR"}],
               "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"\"\<Correlation Distance\>\"", ",", "finalCorr"}], 
              "}"}], ",", 
             RowBox[{"{", 
              RowBox[{
              "\"\<Structural Similarity (SSIM)\>\"", ",", "finalSSIM"}], 
              "}"}]}], "}"}], ",", 
           RowBox[{"Frame", "->", "All"}], ",", 
           RowBox[{"Background", "->", 
            RowBox[{"{", 
             RowBox[{"None", ",", 
              RowBox[{"{", 
               RowBox[{"White", ",", 
                RowBox[{"Lighter", "[", 
                 RowBox[{"Gray", ",", "0.95"}], "]"}]}], "}"}]}], "}"}]}]}], 
          "]"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{
          "\"\<Understanding the Metrics\>\"", ",", "\"\<Subtitle\>\""}], 
          "]"}], ",", 
         RowBox[{"Grid", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{"\"\<MSE\>\"", ",", "Bold"}], "]"}], ",", 
               "\"\<Lower is better. Measures average squared intensity \
difference. Ideal = 0.\>\""}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{"\"\<PSNR\>\"", ",", "Bold"}], "]"}], ",", 
               "\"\<Higher is better. Measures signal strength against noise. \
Ideal > 30 dB.\>\""}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{"\"\<Correlation\>\"", ",", "Bold"}], "]"}], ",", 
               "\"\<Lower is better. Measures pattern divergence. Ideal = \
0.\>\""}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{"\"\<SSIM\>\"", ",", "Bold"}], "]"}], ",", 
               "\"\<Higher is better. Measures 'human-like' quality based on \
structure. Ideal = 1.0.\>\""}], "}"}]}], "}"}], ",", 
           RowBox[{"Alignment", "->", "Left"}], ",", 
           RowBox[{"Frame", "->", "All"}], ",", 
           RowBox[{"ItemSize", "->", 
            RowBox[{"{", 
             RowBox[{"{", 
              RowBox[{"12", ",", "43"}], "}"}], "}"}]}]}], "]"}]}], "}"}], 
       ",", 
       RowBox[{"Spacings", "->", "2"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"6.", " ", "EXPORT"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "exportPath", "=", 
     "\"\<C:\\\\Users\\\\izzyk\\\\OneDrive\\\\Documents\\\\GitHub\\\\\
compressed-sensing\\\\Comparison_Report.pdf\>\""}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"FileExistsQ", "[", "exportPath", "]"}], ",", 
      RowBox[{"Check", "[", 
       RowBox[{
        RowBox[{"DeleteFile", "[", "exportPath", "]"}], ",", 
        RowBox[{
         RowBox[{
         "Print", "[", 
          "\"\<Error: Please close the PDF file in your viewer before running \
this script!\>\"", "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Abort", "[", "]"}]}]}], "]"}]}], "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Export", "[", 
     RowBox[{"exportPath", ",", "report"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Success! Report saved to: \>\"", "<>", "exportPath"}], 
     "]"}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.981687945028139*^9, 3.981687945028139*^9}},
 CellLabel->
